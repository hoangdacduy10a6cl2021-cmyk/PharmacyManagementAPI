@model List<PharmacyManagementWeb.Models.ApiModels.SupplierModel>
@{
    ViewData["Title"] = "Nhà cung cấp";
    bool isAdmin = User.IsInRole("Admin");
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-blue">
            <div class="tile-icon"><i class="bi bi-truck"></i></div>
            <div><div class="tile-label">Tổng nhà cung cấp</div><div class="tile-value">@Model.Count</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-green">
            <div class="tile-icon"><i class="bi bi-check2-circle"></i></div>
            <div><div class="tile-label">Đang hoạt động</div><div class="tile-value">@Model.Count(s => s.IsActive)</div></div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="col-12 col-xl-6 d-flex align-items-center justify-content-xl-end">
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Thêm nhà cung cấp</a>
        </div>
    }
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nhà cung cấp</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th>Trạng thái</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(s.Name) ? "?" : s.Name.Trim().Substring(0, 1).ToUpper();
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle" style="border-radius:12px;">@initial</div>
                                <span class="fw-semibold">@s.Name</span>
                            </div>
                        </td>
                        <td>@(string.IsNullOrEmpty(s.Phone) ? "-" : s.Phone)</td>
                        <td class="text-muted">@(string.IsNullOrEmpty(s.Email) ? "-" : s.Email)</td>
                        <td class="text-muted">@(string.IsNullOrEmpty(s.Address) ? "-" : s.Address)</td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="status-pill pill-green">Hoạt động</span>
                            }
                            else
                            {
                                <span class="status-pill pill-gray">Ngừng hoạt động</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="act-btn" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận xoá/ngưng hoạt động nhà cung cấp này?');">
                                    <button type="submit" class="act-btn danger" title="Xoá"><i class="bi bi-trash3"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6"><div class="empty-state"><i class="bi bi-truck"></i>Chưa có nhà cung cấp nào.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>