@model List<PharmacyManagementWeb.Models.ApiModels.PurchaseOrderModel>
@{
    ViewData["Title"] = "Nhập hàng";
    bool isAdmin = User.IsInRole("Admin");
    int thisMonth = Model.Count(p => p.ImportDate.Year == DateTime.Now.Year && p.ImportDate.Month == DateTime.Now.Month);
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-blue">
            <div class="tile-icon"><i class="bi bi-box-seam"></i></div>
            <div><div class="tile-label">Tổng phiếu nhập</div><div class="tile-value">@Model.Count</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-green">
            <div class="tile-icon"><i class="bi bi-cash-coin"></i></div>
            <div><div class="tile-label">Tổng tiền nhập</div><div class="tile-value">@Model.Sum(p => p.TotalAmount).ToString("N0")đ</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-orange">
            <div class="tile-icon"><i class="bi bi-calendar-check"></i></div>
            <div><div class="tile-label">Phiếu tháng này</div><div class="tile-value">@thisMonth</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success w-100 h-100 d-flex align-items-center justify-content-center fw-semibold" style="min-height:68px;">
                <i class="bi bi-plus-lg me-2"></i>Tạo phiếu nhập
            </a>
        }
    </div>
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Người nhập</th>
                    <th>Ngày nhập</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold" style="color:var(--pharmacy-primary-dark);">@p.Code</td>
                        <td>@p.SupplierName</td>
                        <td>@p.UserName</td>
                        <td>@p.ImportDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end fw-semibold">@p.TotalAmount.ToString("N0")đ</td>
                        <td><span class="status-pill pill-green">@p.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Detail" asp-route-id="@p.Id" class="act-btn" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><i class="bi bi-box-seam"></i>Chưa có phiếu nhập nào.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>