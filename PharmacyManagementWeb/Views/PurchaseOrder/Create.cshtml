@inject IConfiguration Config
@{
    ViewData["Title"] = "Tạo phiếu nhập";
    var suppliers = ViewBag.Suppliers as List<PharmacyManagementWeb.Models.ApiModels.SupplierModel> ?? new();
    var categories = ViewBag.Categories as List<PharmacyManagementWeb.Models.ApiModels.CategoryModel> ?? new();
    object outOfStockData = ViewBag.OutOfStock ?? new List<object>();
    var outOfStockJson = System.Text.Json.JsonSerializer.Serialize(outOfStockData);
}

<style>
    .pos-search { position: relative; }
    .pos-search > i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
    .pos-search input { padding: 0.8rem 1rem 0.8rem 2.8rem; border-radius: 14px; }
    .search-dropdown {
        position: absolute; left: 0; right: 0; top: calc(100% + 6px); background: #fff;
        border: 1px solid #e8edeb; border-radius: 14px; box-shadow: 0 12px 30px rgba(16,24,40,0.12);
        max-height: 320px; overflow-y: auto; z-index: 1000; display: none;
    }
    .search-item { display: flex; align-items: center; gap: 0.8rem; width: 100%; padding: 0.6rem 0.9rem; border: 0; background: transparent; text-align: left; border-bottom: 1px solid #f1f5f4; }
    .search-item:hover { background: var(--pharmacy-primary-soft); }
    .btn-del { border: 0; background: #fef2f2; color: #dc2626; width: 34px; height: 34px; border-radius: 10px; }
    .cart-empty { text-align: center; padding: 2.5rem 1rem; color: #94a3b8; }
    .cart-empty i { font-size: 2.4rem; display: block; margin-bottom: 0.4rem; }
    .pos-side { position: sticky; top: 90px; }
    .total-row { display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #dbe4e1; margin-top: 0.8rem; padding-top: 0.9rem; }
    .total-row .total-value { font-size: 1.6rem; font-weight: 700; color: var(--pharmacy-primary); }
    .btn-checkout {
        width: 100%; border: 0; border-radius: 14px; padding: 0.9rem; font-size: 1.05rem; font-weight: 700; color: #fff;
        background: linear-gradient(90deg, var(--pharmacy-primary), var(--pharmacy-primary-dark));
        display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    }
    .btn-checkout:disabled { background: #cbd5e1; cursor: not-allowed; }
</style>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="stat-card mb-3" id="outOfStockCard" style="display:none;">
            <h6 class="mb-2"><i class="bi bi-exclamation-triangle text-danger me-1"></i> Thuốc đã hết hàng</h6>
            <div class="text-muted small mb-2">Bấm vào thuốc để thêm vào phiếu, nhà cung cấp sẽ được tự động chọn.</div>
            <div id="outOfStockList" class="d-flex flex-wrap gap-2"></div>
        </div>

        <div class="stat-card mb-3">
            <div class="d-flex gap-2">
                <div class="pos-search flex-grow-1">
                <i class="bi bi-search"></i>
                <input type="text" id="medicineSearch" class="form-control" placeholder="Tìm thuốc cần nhập theo tên hoặc mã..." autocomplete="off" />
                <div id="searchResults" class="search-dropdown"></div>
                </div>
                <button type="button" class="btn btn-outline-success text-nowrap" data-bs-toggle="modal" data-bs-target="#newMedicineModal">
                    <i class="bi bi-plus-circle me-1"></i>Thuốc mới
                </button>
            </div>
        </div>

        <div class="stat-card">
            <h6 class="mb-3"><i class="bi bi-box-seam me-1"></i> Danh sách thuốc nhập</h6>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Tên thuốc</th>
                            <th style="width:110px;">Số lượng</th>
                            <th style="width:150px;">Giá nhập</th>
                            <th class="text-end">Thành tiền</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="cartBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="pos-side">
            <div class="stat-card">
                <label class="form-label"><i class="bi bi-truck me-1"></i> Nhà cung cấp</label>
                <select id="supplierSelect" class="form-select mb-3">
                    <option value="">-- Chọn nhà cung cấp --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <div id="supplierNote" class="small mb-3" style="display:none;"></div>

                <div class="total-row">
                    <span class="fw-bold">Tổng tiền nhập</span>
                    <span class="total-value" id="totalAmountText">0đ</span>
                </div>

                <form id="createForm" asp-action="Create" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="supplierId" id="hiddenSupplierId" />
                    <input type="hidden" name="cartJson" id="hiddenCartJson" />
                    <button type="submit" id="createBtn" class="btn-checkout" disabled><i class="bi bi-check2-circle"></i> Tạo phiếu nhập</button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newMedicineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-capsule me-1"></i> Thêm loại thuốc mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="newMedError" class="alert alert-danger py-2" style="display:none;"></div>
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small mb-1">Tên thuốc <span class="text-danger">*</span></label>
                        <input type="text" id="nmName" class="form-control" maxlength="150" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Mã thuốc</label>
                        <input type="text" id="nmCode" class="form-control" maxlength="20" placeholder="Để trống để tự tạo" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Danh mục <span class="text-danger">*</span></label>
                        <select id="nmCategory" class="form-select">
                            <option value="">-- Chọn --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Đơn vị tính</label>
                        <input type="text" id="nmUnit" class="form-control" value="Hộp" maxlength="20" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Mã vạch</label>
                        <input type="text" id="nmBarcode" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Giá nhập</label>
                        <input type="number" id="nmImportPrice" class="form-control" min="0" step="any" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Giá bán</label>
                        <input type="number" id="nmSellPrice" class="form-control" min="0" step="any" value="0" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1">Nhà cung cấp</label>
                        <select id="nmSupplier" class="form-select">
                            <option value="">-- Theo nhà cung cấp của phiếu nhập --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="text-muted small mt-2">Thuốc mới được tạo với tồn kho 0, số lượng sẽ được cộng khi bạn lưu phiếu nhập.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="nmSaveBtn" class="btn btn-success"><i class="bi bi-check2 me-1"></i>Tạo và thêm vào phiếu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const apiBase = '@Config["ApiSettings:BaseUrl"]';

    let cart = [];            // { medicineId, code, name, importPrice, quantity, imageUrl }
    let lastResults = [];

    const searchInput = document.getElementById('medicineSearch');
    const searchResults = document.getElementById('searchResults');
    let searchTimeout;

    function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function money(n) { return Number(n).toLocaleString('vi-VN') + 'đ'; }
    function thumb(url, size) {
        if (url) return `<img src="${apiBase}${url}" style="width:${size}px;height:${size}px;object-fit:cover;border-radius:8px;flex-shrink:0;" />`;
        return `<div class="d-flex align-items-center justify-content-center bg-light text-muted" style="width:${size}px;height:${size}px;border-radius:8px;font-size:10px;flex-shrink:0;">No img</div>`;
    }

    searchInput.addEventListener('input', function () {
        clearTimeout(searchTimeout);
        const term = this.value.trim();
        if (term.length === 0) { searchResults.style.display = 'none'; return; }

        searchTimeout = setTimeout(async () => {
            const res = await fetch('/PurchaseOrder/SearchMedicine?term=' + encodeURIComponent(term));
            lastResults = await res.json();
            renderSearchResults(lastResults);
        }, 250);
    });

    function renderSearchResults(items) {
        if (!items.length) {
            searchResults.innerHTML = '<div class="p-3 text-muted small">Không tìm thấy thuốc.</div>';
            searchResults.style.display = 'block';
            return;
        }
        searchResults.innerHTML = items.map((m, idx) => `
            <button type="button" class="search-item" onclick="addFromResults(${idx})">
                ${thumb(m.imageUrl, 44)}
                <div class="flex-grow-1">
                    <div class="fw-semibold">${esc(m.name)}</div>
                    <div class="text-muted small">${esc(m.code)} · Tồn hiện tại: ${m.stock <= 0 ? '<span class="text-danger fw-semibold">Hết hàng</span>' : m.stock}${m.supplierName ? ' · NCC: ' + esc(m.supplierName) : ''}</div>
                </div>
            </button>
        `).join('');
        searchResults.style.display = 'block';
    }

    function addFromResults(idx) { addToCart(lastResults[idx]); }

    document.addEventListener('click', function (e) {
        if (!searchResults.contains(e.target) && e.target !== searchInput) searchResults.style.display = 'none';
    });

    function addToCart(medicine) {
        if (cart.find(i => i.medicineId === medicine.id)) {
            alert('Thuốc này đã có trong phiếu nhập.');
        } else {
           cart.push({ medicineId: medicine.id, code: medicine.code, name: medicine.name, importPrice: medicine.importPrice || 0, quantity: 1, imageUrl: medicine.imageUrl, batchNumber: '', expiryDate: '' });
            autoFillSupplier(medicine);
        }
        searchInput.value = '';
        searchResults.style.display = 'none';
        renderCart();
    }

    // Tự động chọn nhà cung cấp theo thuốc được thêm vào phiếu (một phiếu nhập chỉ có 1 nhà cung cấp)
    function autoFillSupplier(medicine) {
        const sel = document.getElementById('supplierSelect');
        const note = document.getElementById('supplierNote');
        if (!medicine.supplierId) return;

        const supplierId = String(medicine.supplierId);
        const optionExists = Array.from(sel.options).some(o => o.value === supplierId);
        if (!optionExists) return;

        // Chưa chọn nhà cung cấp, hoặc đây là thuốc đầu tiên của phiếu -> tự điền
        if (!sel.value || cart.length <= 1) {
            sel.value = supplierId;
            note.className = 'small mb-3 text-success';
            note.innerHTML = '<i class="bi bi-magic me-1"></i>Đã tự chọn nhà cung cấp <b>' + esc(medicine.supplierName || '') + '</b> theo thuốc <b>' + esc(medicine.name) + '</b>.';
            note.style.display = 'block';
        } else if (sel.value !== supplierId) {
            note.className = 'small mb-3 text-warning';
            note.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Thuốc <b>' + esc(medicine.name) + '</b> thuộc nhà cung cấp <b>' + esc(medicine.supplierName || '') + '</b>, khác với nhà cung cấp đang chọn. Mỗi phiếu nhập chỉ có một nhà cung cấp, hãy tạo phiếu riêng nếu cần.';
            note.style.display = 'block';
        }
        updateSummary();
    }

    // Danh sách thuốc đã hết hàng để nhập nhanh
    const outOfStock = @Html.Raw(outOfStockJson);
    (function renderOutOfStock() {
        if (!outOfStock.length) return;
        document.getElementById('outOfStockCard').style.display = 'block';
        document.getElementById('outOfStockList').innerHTML = outOfStock.map((m, idx) =>
            `<button type="button" class="btn btn-sm btn-outline-danger" onclick="addOutOfStock(${idx})">
                <i class="bi bi-plus-circle me-1"></i>${esc(m.name)}${m.supplierName ? ' <span class="text-muted">(' + esc(m.supplierName) + ')</span>' : ''}
            </button>`).join('');
    })();
    function addOutOfStock(idx) { addToCart(outOfStock[idx]); }

    // Tạo nhanh loại thuốc mới
    document.getElementById('nmSaveBtn').addEventListener('click', async function () {
        const errBox = document.getElementById('newMedError');
        errBox.style.display = 'none';

        const body = new URLSearchParams();
        body.append('__RequestVerificationToken', document.querySelector('#createForm input[name="__RequestVerificationToken"]').value);
        body.append('name', document.getElementById('nmName').value.trim());
        body.append('code', document.getElementById('nmCode').value.trim());
        body.append('categoryId', document.getElementById('nmCategory').value || '0');
        body.append('unit', document.getElementById('nmUnit').value.trim());
        body.append('barcode', document.getElementById('nmBarcode').value.trim());
        body.append('importPrice', document.getElementById('nmImportPrice').value || '0');
        body.append('sellPrice', document.getElementById('nmSellPrice').value || '0');
        const supplierId = document.getElementById('nmSupplier').value || document.getElementById('supplierSelect').value;
        if (supplierId) body.append('supplierId', supplierId);

        this.disabled = true;
        try {
            const res = await fetch('/PurchaseOrder/QuickCreateMedicine', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                errBox.textContent = data.message || 'Không thể tạo thuốc mới.';
                errBox.style.display = 'block';
                return;
            }

            bootstrap.Modal.getInstance(document.getElementById('newMedicineModal')).hide();
            ['nmName', 'nmCode', 'nmBarcode'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('nmImportPrice').value = 0;
            document.getElementById('nmSellPrice').value = 0;
            addToCart(data);
        } finally {
            this.disabled = false;
        }
    });

    function removeFromCart(medicineId) { cart = cart.filter(i => i.medicineId !== medicineId); renderCart(); }

    function updateQuantity(medicineId, value) {
        const item = cart.find(i => i.medicineId === medicineId);
        if (item) item.quantity = Math.max(1, parseInt(value) || 1);
        renderCart();
    }

    function updateImportPrice(medicineId, value) {
        const item = cart.find(i => i.medicineId === medicineId);
        if (item) item.importPrice = Math.max(0, parseFloat(value) || 0);
        renderCart();
    }
        function updateBatchNumber(medicineId, value) {
        const item = cart.find(i => i.medicineId === medicineId);
        if (item) item.batchNumber = value;
    }

    function updateExpiry(medicineId, value) {
        const item = cart.find(i => i.medicineId === medicineId);
        if (item) item.expiryDate = value;
    }

    function renderCart() {
        const body = document.getElementById('cartBody');
        if (cart.length === 0) {
            body.innerHTML = '<tr><td colspan="5"><div class="cart-empty"><i class="bi bi-basket"></i>Chưa có thuốc nào trong phiếu nhập.</div></td></tr>';
        } else {
            body.innerHTML = cart.map(i => `
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            ${thumb(i.imageUrl, 44)}
                                                        <div><div class="fw-semibold">${esc(i.name)}</div><div class="text-muted small">${esc(i.code)}</div></div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <input type="text" class="form-control form-control-sm" style="max-width:150px;" placeholder="Số lô (tự tạo nếu bỏ trống)"
                                   value="${esc(i.batchNumber)}" onchange="updateBatchNumber(${i.medicineId}, this.value)" />
                            <input type="date" class="form-control form-control-sm" style="max-width:150px;" title="Hạn sử dụng của lô"
                                   value="${i.expiryDate}" onchange="updateExpiry(${i.medicineId}, this.value)" />
                        </div>
                    </td>
                    <td><input type="number" class="form-control form-control-sm" value="${i.quantity}" min="1" onchange="updateQuantity(${i.medicineId}, this.value)" /></td>
                    <td><input type="number" class="form-control form-control-sm" value="${i.importPrice}" min="0" step="any" onchange="updateImportPrice(${i.medicineId}, this.value)" /></td>
                    <td class="text-end fw-semibold">${money(i.importPrice * i.quantity)}</td>
                    <td class="text-end"><button type="button" class="btn-del" onclick="removeFromCart(${i.medicineId})"><i class="bi bi-trash3"></i></button></td>
                </tr>
            `).join('');
        }
        updateSummary();
    }

    function updateSummary() {
        const total = cart.reduce((sum, i) => sum + i.importPrice * i.quantity, 0);
        document.getElementById('totalAmountText').textContent = money(total);
        const supplierId = document.getElementById('supplierSelect').value;
        document.getElementById('createBtn').disabled = cart.length === 0 || !supplierId;
    }

    document.getElementById('supplierSelect').addEventListener('change', updateSummary);

    document.getElementById('createForm').addEventListener('submit', function (e) {
        if (cart.length === 0) { e.preventDefault(); return; }
        document.getElementById('hiddenSupplierId').value = document.getElementById('supplierSelect').value;
                const missingExpiry = cart.filter(i => !i.expiryDate);
        if (missingExpiry.length > 0) {
            e.preventDefault();
            alert('Vui lòng nhập hạn sử dụng cho: ' + missingExpiry.map(i => i.name).join(', '));
            return;
        }

        document.getElementById('hiddenCartJson').value = JSON.stringify(cart.map(i => ({
            medicineId: i.medicineId, quantity: i.quantity, importPrice: i.importPrice,
            batchNumber: i.batchNumber || null, expiryDate: i.expiryDate
        })));
    });

    renderCart();
</script>
}