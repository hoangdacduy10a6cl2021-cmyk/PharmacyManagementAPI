@inject IConfiguration Config
@{
    ViewData["Title"] = "Tạo phiếu tư vấn";
    var customers = ViewBag.Customers as List<PharmacyManagementWeb.Models.ApiModels.CustomerModel> ?? new();
    int? selectedCustomerId = ViewBag.SelectedCustomerId as int?;
}

<style>
    .pos-search { position: relative; }
    .pos-search > i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
    .pos-search input { padding: 0.8rem 1rem 0.8rem 2.8rem; border-radius: 14px; }
    .search-dropdown {
        position: absolute; left: 0; right: 0; top: calc(100% + 6px); background: #fff;
        border: 1px solid #e8edeb; border-radius: 14px; box-shadow: 0 12px 30px rgba(16,24,40,0.12);
        max-height: 300px; overflow-y: auto; z-index: 1000; display: none;
    }
    .search-item { display: flex; align-items: center; gap: 0.8rem; width: 100%; padding: 0.6rem 0.9rem; border: 0; background: transparent; text-align: left; border-bottom: 1px solid #f1f5f4; }
    .search-item:hover { background: var(--pharmacy-primary-soft); }
    .chosen-item { display: flex; align-items: center; gap: 0.8rem; padding: 0.55rem 0.8rem; border: 1px solid #e8edeb; border-radius: 12px; margin-bottom: 0.5rem; }
    .btn-del { border: 0; background: #fef2f2; color: #dc2626; width: 32px; height: 32px; border-radius: 10px; }
</style>

<form id="consultForm" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="medicineIdsJson" id="medicineIdsJson" />

    <div class="row g-3">
        <div class="col-xl-8">
            <div class="stat-card mb-3">
                <h6 class="mb-3"><i class="bi bi-person-circle me-1"></i>Khách hàng</h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Chọn khách hàng đã lưu</label>
                        <select name="customerId" id="customerSelect" class="form-select">
                            <option value="">-- Khách vãng lai / chưa lưu --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id" selected="@(selectedCustomerId == c.Id)">@c.Name @(string.IsNullOrEmpty(c.Phone) ? "" : $"- {c.Phone}")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-7 guest-field">
                        <label class="form-label">Tên khách</label>
                        <input type="text" name="customerName" class="form-control" maxlength="100" placeholder="Để trống sẽ ghi là Khách vãng lai" />
                    </div>
                    <div class="col-md-5 guest-field">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="customerPhone" class="form-control" maxlength="20" />
                    </div>
                </div>
            </div>

            <div class="stat-card mb-3">
                <h6 class="mb-3"><i class="bi bi-clipboard2-pulse me-1"></i>Nội dung tư vấn</h6>
                <div class="mb-3">
                    <label class="form-label">Triệu chứng / yêu cầu của khách</label>
                    <textarea name="symptoms" class="form-control" rows="3" maxlength="500" required placeholder="Ví dụ: Ho khan 3 ngày, đau họng, không sốt"></textarea>
                </div>
                <div>
                    <label class="form-label">Tư vấn của dược sĩ</label>
                    <textarea name="advice" class="form-control" rows="4" maxlength="1000" required placeholder="Ví dụ: Uống thuốc sau ăn, uống nhiều nước ấm, tái khám nếu sốt trên 38.5 độ"></textarea>
                </div>
            </div>

            <div class="stat-card">
                <h6 class="mb-3"><i class="bi bi-capsule me-1"></i>Thuốc gợi ý <span class="text-muted fw-normal small">(không bắt buộc)</span></h6>

                <div class="pos-search mb-3">
                    <i class="bi bi-search"></i>
                    <input type="text" id="medicineSearch" class="form-control" placeholder="Tìm tên hoặc mã thuốc để thêm..." autocomplete="off" />
                    <div id="searchResults" class="search-dropdown"></div>
                </div>

                <div id="chosenList"></div>
            </div>
        </div>

        <div class="col-xl-4">
            <div style="position:sticky; top:90px;">
                <div class="stat-card">
                    <h6 class="mb-3"><i class="bi bi-calendar-event me-1"></i>Hẹn theo dõi</h6>
                    <input type="date" name="followUpDate" id="followUpDate" class="form-control" />
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setFollow(3)">+3 ngày</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setFollow(7)">+7 ngày</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setFollow(null)">Bỏ hẹn</button>
                    </div>
                    <div class="form-text mt-2">Có ngày hẹn thì phiếu ở trạng thái <strong>Cần theo dõi</strong> để dược sĩ nhớ hỏi thăm khách. Không hẹn thì phiếu <strong>Hoàn tất</strong> ngay.</div>

                    <button type="submit" class="btn btn-success w-100 mt-3"><i class="bi bi-check2-circle me-1"></i>Lưu phiếu tư vấn</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Huỷ</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const apiBase = '@Config["ApiSettings:BaseUrl"]';

        let chosen = [];      // { id, name, code, unit, imageUrl }
        let lastResults = [];
        let searchTimeout;

        const searchInput = document.getElementById('medicineSearch');
        const searchResults = document.getElementById('searchResults');

        function esc(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        function thumb(url, size) {
            if (url) return `<img src="${apiBase}${url}" style="width:${size}px;height:${size}px;object-fit:cover;border-radius:8px;flex-shrink:0;" />`;
            return `<div class="d-flex align-items-center justify-content-center bg-light text-muted" style="width:${size}px;height:${size}px;border-radius:8px;font-size:10px;flex-shrink:0;">No img</div>`;
        }

        // ===== Khách hàng: chỉ hiện ô tên / SĐT khi chọn khách vãng lai =====
        function toggleGuest() {
            const isGuest = document.getElementById('customerSelect').value === '';
            document.querySelectorAll('.guest-field').forEach(el => el.style.display = isGuest ? '' : 'none');
        }
        document.getElementById('customerSelect').addEventListener('change', toggleGuest);
        toggleGuest();

        // ===== Tìm thuốc =====
        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimeout);
            const term = this.value.trim();
            if (!term) { searchResults.style.display = 'none'; return; }

            searchTimeout = setTimeout(async () => {
                const res = await fetch('/Order/SearchMedicine?term=' + encodeURIComponent(term));
                lastResults = await res.json();
                renderResults();
            }, 250);
        });

        function renderResults() {
            if (!lastResults.length) {
                searchResults.innerHTML = '<div class="p-3 text-muted small">Không tìm thấy thuốc.</div>';
                searchResults.style.display = 'block';
                return;
            }
            searchResults.innerHTML = lastResults.map((m, idx) => `
                <button type="button" class="search-item" onclick="addMedicine(${idx})">
                    ${thumb(m.imageUrl, 40)}
                    <div class="flex-grow-1">
                        <div class="fw-semibold">${esc(m.name)}</div>
                        <div class="text-muted small">${esc(m.code)} · Tồn: ${m.stock} ${esc(m.unit)}</div>
                    </div>
                </button>
            `).join('');
            searchResults.style.display = 'block';
        }

        document.addEventListener('click', function (e) {
            if (!searchResults.contains(e.target) && e.target !== searchInput) searchResults.style.display = 'none';
        });

        function addMedicine(idx) {
            const m = lastResults[idx];
            if (!chosen.find(c => c.id === m.id)) {
                chosen.push({ id: m.id, name: m.name, code: m.code, unit: m.unit, imageUrl: m.imageUrl });
            }
            searchInput.value = '';
            searchResults.style.display = 'none';
            renderChosen();
        }

        function removeMedicine(id) {
            chosen = chosen.filter(c => c.id !== id);
            renderChosen();
        }

        function renderChosen() {
            const box = document.getElementById('chosenList');
            if (!chosen.length) {
                box.innerHTML = '<div class="text-muted small text-center py-3">Chưa chọn thuốc nào.</div>';
                return;
            }
            box.innerHTML = chosen.map(c => `
                <div class="chosen-item">
                    ${thumb(c.imageUrl, 44)}
                    <div class="flex-grow-1">
                        <div class="fw-semibold">${esc(c.name)}</div>
                        <div class="text-muted small">${esc(c.code)} · ${esc(c.unit)}</div>
                    </div>
                    <button type="button" class="btn-del" onclick="removeMedicine(${c.id})"><i class="bi bi-trash3"></i></button>
                </div>
            `).join('');
        }

        // ===== Ngày hẹn nhanh =====
        function setFollow(days) {
            const input = document.getElementById('followUpDate');
            if (days === null) { input.value = ''; return; }
            const d = new Date();
            d.setDate(d.getDate() + days);
            const pad = n => String(n).padStart(2, '0');
            input.value = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        }

        document.getElementById('consultForm').addEventListener('submit', function () {
            document.getElementById('medicineIdsJson').value = JSON.stringify(chosen.map(c => c.id));
        });

        renderChosen();
    </script>
}