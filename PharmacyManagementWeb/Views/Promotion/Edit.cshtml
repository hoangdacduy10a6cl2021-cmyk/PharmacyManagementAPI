@model PharmacyManagementWeb.Models.ApiModels.PromotionFormViewModel
@{
    ViewData["Title"] = "Sửa khuyến mãi";
}

<div class="stat-card form-card" style="max-width:680px;">
    <div class="form-head">
        <div class="fh-icon"><i class="bi bi-percent"></i></div>
        <div>
            <h5>@ViewData["Title"]</h5>
            <div class="sub">Cập nhật chương trình giảm giá</div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Mã khuyến mãi</label>
                <input value="@Model.Code" class="form-control" disabled />
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DiscountType" class="form-label"></label>
                <select asp-for="DiscountType" class="form-select">
                    <option value="PhanTram">Theo phần trăm (%)</option>
                    <option value="SoTien">Theo số tiền (đ)</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="DiscountValue" class="form-label"></label>
                <input asp-for="DiscountValue" class="form-control" type="number" step="any" />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
            <div class="col-12 form-check ms-1">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success px-4"><i class="bi bi-check2 me-1"></i>Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}