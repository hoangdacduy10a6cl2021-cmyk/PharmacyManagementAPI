@model List<PharmacyManagementWeb.Models.ApiModels.PromotionModel>
@{
    ViewData["Title"] = "Khuyến mãi";
    bool isAdmin = User.IsInRole("Admin");
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-blue">
            <div class="tile-icon"><i class="bi bi-percent"></i></div>
            <div><div class="tile-label">Tổng chương trình</div><div class="tile-value">@Model.Count</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-green">
            <div class="tile-icon"><i class="bi bi-play-circle"></i></div>
            <div><div class="tile-label">Đang diễn ra</div><div class="tile-value">@Model.Count(p => p.CurrentStatus == "Đang diễn ra")</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-orange">
            <div class="tile-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="tile-label">Chưa bắt đầu</div><div class="tile-value">@Model.Count(p => p.CurrentStatus == "Chưa bắt đầu")</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-red">
            <div class="tile-icon"><i class="bi bi-stop-circle"></i></div>
            <div><div class="tile-label">Đã kết thúc</div><div class="tile-value">@Model.Count(p => p.CurrentStatus == "Đã kết thúc")</div></div>
        </div>
    </div>
</div>

@if (isAdmin)
{
    <div class="stat-card mb-3 d-flex justify-content-between align-items-center">
        <span class="text-muted">Quản lý các chương trình giảm giá của cửa hàng</span>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Tạo khuyến mãi</a>
    </div>
}

<div class="stat-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Mã KM</th>
                    <th>Tên chương trình</th>
                    <th>Loại</th>
                    <th class="text-end">Giá trị</th>
                    <th>Thời gian áp dụng</th>
                    <th>Trạng thái</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var pill = p.CurrentStatus switch
                    {
                        "Đang diễn ra" => "pill-green",
                        "Chưa bắt đầu" => "pill-blue",
                        "Đã kết thúc" => "pill-gray",
                        _ => "pill-yellow"
                    };
                    <tr>
                        <td class="fw-semibold" style="color:var(--pharmacy-primary-dark);">@p.Code</td>
                        <td class="fw-semibold">@p.Name</td>
                        <td><span class="soft-tag">@(p.DiscountType == "PhanTram" ? "Theo %" : "Theo số tiền")</span></td>
                        <td class="text-end fw-semibold">@(p.DiscountType == "PhanTram" ? $"{p.DiscountValue:0.##}%" : $"{p.DiscountValue:N0}đ")</td>
                        <td>@p.StartDate.ToString("dd/MM") - @p.EndDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="status-pill @pill">@p.CurrentStatus</span></td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="act-btn" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận xoá khuyến mãi này?');">
                                    <button type="submit" class="act-btn danger" title="Xoá"><i class="bi bi-trash3"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><i class="bi bi-percent"></i>Chưa có chương trình khuyến mãi nào.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>