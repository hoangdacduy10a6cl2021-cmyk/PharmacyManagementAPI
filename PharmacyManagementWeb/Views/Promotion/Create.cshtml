@model PharmacyManagementWeb.Models.ApiModels.PromotionFormViewModel
@{
    ViewData["Title"] = "Tạo khuyến mãi";
}

<div class="stat-card" style="max-width: 650px;">
    <h6 class="mb-3">@ViewData["Title"]</h6>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" autofocus />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DiscountType" class="form-label"></label>
                <select asp-for="DiscountType" class="form-select">
                    <option value="PhanTram">Theo phần trăm (%)</option>
                    <option value="SoTien">Theo số tiền (đ)</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="DiscountValue" class="form-label"></label>
                <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
