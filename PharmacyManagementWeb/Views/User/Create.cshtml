@model PharmacyManagementWeb.Models.ApiModels.UserCreateViewModel
@{
    ViewData["Title"] = "Thêm nhân viên";
}

<div class="stat-card form-card" style="max-width:700px;">
    <div class="form-head">
        <div class="fh-icon"><i class="bi bi-person-plus"></i></div>
        <div>
            <h5>@ViewData["Title"]</h5>
            <div class="sub">Tạo tài khoản đăng nhập cho nhân viên hoặc dược sĩ</div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="section-title" style="margin-top:0;">Thông tin cá nhân</div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
        </div>

        <div class="section-title">Tài khoản đăng nhập</div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="off" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="section-title">Phân quyền</div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="NhanVien">Nhân viên bán hàng / Dược sĩ</option>
                    <option value="Admin">Quản trị viên (toàn quyền)</option>
                </select>
                <div class="form-text">Xem chi tiết quyền ở trang <a asp-action="Permissions">Phân quyền</a>.</div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success px-4"><i class="bi bi-check2 me-1"></i>Tạo tài khoản</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}