@model PharmacyManagementWeb.Models.ApiModels.DashboardModel
@{
    ViewData["Title"] = "Trang chủ";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-icon-green">💰</div>
            <div class="stat-value">@Model.TodayRevenue.ToString("N0")đ</div>
            <div class="stat-label">Doanh thu hôm nay</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-icon-blue">🧾</div>
            <div class="stat-value">@Model.TodayOrders</div>
            <div class="stat-label">Đơn hàng hôm nay</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-icon-orange">📉</div>
            <div class="stat-value">@Model.LowStockCount</div>
            <div class="stat-label">Sản phẩm sắp hết</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-icon-red">⏰</div>
            <div class="stat-value">@Model.ExpiringSoonCount</div>
            <div class="stat-label">Sản phẩm sắp hết hạn</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="stat-card">
            <h6 class="mb-3">Doanh thu 7 ngày gần đây</h6>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th class="text-end">Doanh thu</th>
                        <th class="text-end">Số đơn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in Model.RevenueLast7Days)
                    {
                        <tr>
                            <td>@day.Date.ToString("dd/MM")</td>
                            <td class="text-end">@day.Revenue.ToString("N0")đ</td>
                            <td class="text-end">@day.OrderCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-5">
        <div class="stat-card">
            <h6 class="mb-3">Top thuốc bán chạy</h6>
            @if (!Model.TopSellingMedicines.Any())
            {
                <div class="text-muted small">Chưa có dữ liệu bán hàng.</div>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Tên thuốc</th>
                            <th class="text-end">Đã bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.TopSellingMedicines)
                        {
                            <tr>
                                <td>@m.MedicineName</td>
                                <td class="text-end">@m.QuantitySold</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
