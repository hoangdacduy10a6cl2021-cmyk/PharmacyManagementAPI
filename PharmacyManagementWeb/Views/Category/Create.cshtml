@model PharmacyManagementWeb.Models.ApiModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="stat-card form-card" style="max-width:620px;">
    <div class="form-head">
        <div class="fh-icon"><i class="bi bi-tag"></i></div>
        <div>
            <h5>@ViewData["Title"]</h5>
            <div class="sub">Nhóm thuốc để dễ quản lý và tìm kiếm</div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success px-4"><i class="bi bi-check2 me-1"></i>Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}