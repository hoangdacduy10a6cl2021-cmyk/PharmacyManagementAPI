@model PharmacyManagementWeb.Models.ApiModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="stat-card" style="max-width: 600px;">
    <h6 class="mb-3">@ViewData["Title"]</h6>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (ViewBag.MedicineCount != null)
    {
        <div class="alert alert-light border small">Danh mục này đang có <strong>@ViewBag.MedicineCount</strong> thuốc.</div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-success">Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
