@model List<PharmacyManagementWeb.Models.ApiModels.CategoryModel>
@{
    ViewData["Title"] = "Danh mục";
    bool isAdmin = User.IsInRole("Admin");
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-blue">
            <div class="tile-icon"><i class="bi bi-tags"></i></div>
            <div><div class="tile-label">Tổng danh mục</div><div class="tile-value">@Model.Count</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-green">
            <div class="tile-icon"><i class="bi bi-capsule"></i></div>
            <div><div class="tile-label">Tổng số thuốc</div><div class="tile-value">@Model.Sum(c => c.MedicineCount)</div></div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="col-12 col-xl-6 d-flex align-items-center justify-content-xl-end">
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
        </div>
    }
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th class="text-end">Số thuốc</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle" style="border-radius:12px;"><i class="bi bi-tag"></i></div>
                                <span class="fw-semibold">@c.Name</span>
                            </div>
                        </td>
                        <td class="text-muted">@(string.IsNullOrEmpty(c.Description) ? "-" : c.Description)</td>
                        <td class="text-end"><span class="status-pill pill-blue">@c.MedicineCount thuốc</span></td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="act-btn" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận xoá danh mục này?');">
                                    <button type="submit" class="act-btn danger" title="Xoá"><i class="bi bi-trash3"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4"><div class="empty-state"><i class="bi bi-tags"></i>Chưa có danh mục nào.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>