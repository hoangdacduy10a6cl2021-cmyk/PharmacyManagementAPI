@model List<PharmacyManagementWeb.Models.ApiModels.MedicineModel>
@inject IConfiguration Config
@{
    ViewData["Title"] = "Thuốc / Kho";
    bool isAdmin = User.IsInRole("Admin");
    var categories = ViewBag.Categories as List<PharmacyManagementWeb.Models.ApiModels.CategoryModel> ?? new();

    int totalCount = Model.Count;
    int activeCount = Model.Count(m => m.IsActive);
    int lowCount = Model.Count(m => m.Stock <= 20);
    int expCount = Model.Count(m => m.ExpiryDate.HasValue && m.ExpiryDate.Value <= DateTime.Now.AddDays(90));

    bool hasFilter = !string.IsNullOrEmpty(ViewBag.Search as string)
                     || ViewBag.CategoryId != null
                     || ViewBag.LowStock == true
                     || ViewBag.ExpiringSoon == true;
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-blue">
            <div class="tile-icon"><i class="bi bi-capsule"></i></div>
            <div><div class="tile-label">Tổng số thuốc</div><div class="tile-value">@totalCount</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-green">
            <div class="tile-icon"><i class="bi bi-check2-circle"></i></div>
            <div><div class="tile-label">Đang kinh doanh</div><div class="tile-value">@activeCount</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-orange">
            <div class="tile-icon"><i class="bi bi-box-seam"></i></div>
            <div><div class="tile-label">Sắp hết hàng</div><div class="tile-value">@lowCount</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-red">
            <div class="tile-icon"><i class="bi bi-alarm"></i></div>
            <div><div class="tile-label">Sắp hết hạn</div><div class="tile-value">@expCount</div></div>
        </div>
    </div>
</div>

<div class="stat-card mb-3">
    <form method="get" class="list-toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, mã thuốc, mã vạch rồi nhấn Enter..." />
        </div>

        <select name="categoryId" class="form-select filter-select" onchange="this.form.submit()">
            <option value="">Tất cả danh mục</option>
            @foreach (var c in categories)
            {
                if (ViewBag.CategoryId != null && (int)ViewBag.CategoryId == c.Id)
                {
                    <option value="@c.Id" selected>@c.Name</option>
                }
                else
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>

        <label class="filter-chip">
            <input type="checkbox" name="lowStock" value="true" checked="@(ViewBag.LowStock == true)" onchange="this.form.submit()" />
            <span><i class="bi bi-box-seam"></i> Sắp hết hàng</span>
        </label>
        <label class="filter-chip">
            <input type="checkbox" name="expiringSoon" value="true" checked="@(ViewBag.ExpiringSoon == true)" onchange="this.form.submit()" />
            <span><i class="bi bi-alarm"></i> Sắp hết hạn</span>
        </label>

        @if (hasFilter)
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle me-1"></i>Xoá lọc</a>
        }

        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success ms-auto"><i class="bi bi-plus-lg me-1"></i>Thêm thuốc</a>
        }
    </form>
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th style="width:64px;">Ảnh</th>
                    <th>Thuốc</th>
                    <th>Danh mục</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Tồn kho</th>
                    <th>HSD</th>
                    <th>Trạng thái</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    bool expiringSoon = m.ExpiryDate.HasValue && m.ExpiryDate.Value <= DateTime.Now.AddDays(90);
                    bool lowStock = m.Stock <= 20;

                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(m.ImageUrl))
                            {
                                <img src="@(Config["ApiSettings:BaseUrl"])@m.ImageUrl" alt="@m.Name"
                                     style="width:48px; height:48px; object-fit:cover; border-radius:10px;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                                     style="width:48px; height:48px; border-radius:10px; font-size:11px;">No img</div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@m.Name</div>
                            <div class="text-muted small">@m.Code</div>
                        </td>
                        <td><span class="soft-tag">@m.CategoryName</span></td>
                        <td class="text-end">
                            <span class="fw-semibold">@m.SellPrice.ToString("N0")đ</span>
                            @if (!string.IsNullOrEmpty(m.Unit))
                            {
                                <div class="text-muted small">/ @m.Unit</div>
                            }
                        </td>
                        <td class="text-end">
                            <span class="fw-semibold @(lowStock ? "text-danger" : "")">@m.Stock</span>
                        </td>
                        <td class="@(expiringSoon ? "text-warning fw-semibold" : "")">@(m.ExpiryDate?.ToString("MM/yyyy") ?? "-")</td>
                        <td>
                            @if (!m.IsActive)
                            {
                                <span class="status-pill pill-gray">Ngừng KD</span>
                            }
                            else if (expiringSoon)
                            {
                                <span class="status-pill pill-yellow">Sắp hết hạn</span>
                            }
                            else if (lowStock)
                            {
                                <span class="status-pill pill-red">Sắp hết hàng</span>
                            }
                            else
                            {
                                <span class="status-pill pill-green">Còn hàng</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@m.Id" class="act-btn" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận xoá/ngưng kinh doanh thuốc này?');">
                                    <button type="submit" class="act-btn danger" title="Xoá"><i class="bi bi-trash3"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state"><i class="bi bi-capsule"></i>Không tìm thấy thuốc nào.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-foot">Hiển thị @Model.Count thuốc</div>
</div>