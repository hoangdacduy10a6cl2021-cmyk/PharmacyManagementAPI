@model List<PharmacyManagementWeb.Models.ApiModels.CustomerModel>
@{
    ViewData["Title"] = "Khách hàng";
    bool isAdmin = User.IsInRole("Admin");

    int totalCount = Model.Count;
    int vipCount = Model.Count(c => c.CustomerType == "VIP");
    decimal totalSpent = Model.Sum(c => c.TotalSpent);
    int newThisMonth = Model.Count(c => c.CreatedAt.Year == DateTime.Now.Year && c.CreatedAt.Month == DateTime.Now.Month);
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-blue">
            <div class="tile-icon"><i class="bi bi-people"></i></div>
            <div><div class="tile-label">Tổng khách hàng</div><div class="tile-value">@totalCount</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-orange">
            <div class="tile-icon"><i class="bi bi-star"></i></div>
            <div><div class="tile-label">Khách VIP</div><div class="tile-value">@vipCount</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-green">
            <div class="tile-icon"><i class="bi bi-cash-coin"></i></div>
            <div><div class="tile-label">Tổng chi tiêu</div><div class="tile-value">@totalSpent.ToString("N0")đ</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-tile compact tile-red">
            <div class="tile-icon"><i class="bi bi-person-plus"></i></div>
            <div><div class="tile-label">Khách mới tháng này</div><div class="tile-value">@newThisMonth</div></div>
        </div>
    </div>
</div>

<div class="stat-card mb-3">
    <form method="get" class="list-toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên hoặc số điện thoại rồi nhấn Enter..." />
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle me-1"></i>Xoá lọc</a>
        }

        <a asp-action="Create" class="btn btn-success ms-auto"><i class="bi bi-plus-lg me-1"></i>Thêm khách hàng</a>
    </form>
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>SĐT</th>
                    <th>Địa chỉ</th>
                    <th>Loại KH</th>
                    <th class="text-end">Tổng chi tiêu</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(c.Name) ? "?" : c.Name.Trim().Split(' ').Last().Substring(0, 1).ToUpper();

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle">@initial</div>
                                <span class="fw-semibold">@c.Name</span>
                            </div>
                        </td>
                        <td>@(string.IsNullOrEmpty(c.Phone) ? "-" : c.Phone)</td>
                        <td class="text-muted">@(string.IsNullOrEmpty(c.Address) ? "-" : c.Address)</td>
                        <td>
                            @if (c.CustomerType == "VIP")
                            {
                                <span class="status-pill pill-yellow"><i class="bi bi-star-fill"></i> VIP</span>
                            }
                            else
                            {
                                <span class="status-pill pill-green">Thành viên</span>
                            }
                        </td>
                        <td class="text-end fw-semibold">@c.TotalSpent.ToString("N0")đ</td>
                        <td class="text-muted">@c.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="act-btn" title="Sửa"><i class="bi bi-pencil"></i></a>
                            @if (isAdmin)
                            {
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận xoá khách hàng này?');">
                                    <button type="submit" class="act-btn danger" title="Xoá"><i class="bi bi-trash3"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state"><i class="bi bi-people"></i>Không tìm thấy khách hàng nào.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-foot">Hiển thị @Model.Count khách hàng</div>
</div>