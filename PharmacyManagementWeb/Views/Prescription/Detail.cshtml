@model PharmacyManagementWeb.Models.ApiModels.PrescriptionModel
@{
    ViewData["Title"] = "Đơn thuốc #" + Model.Code;
}

<div class="stat-card" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h5 class="mb-0">Chi tiết đơn thuốc #@Model.Code</h5>
            <div class="text-muted small">Ngày kê: @Model.PrescriptionDate.ToString("dd/MM/yyyy")</div>
        </div>
        @if (Model.Status == "Đã giao")
        {
            <span class="badge bg-success fs-6">Đã giao</span>
        }
        else
        {
            <span class="badge bg-warning text-dark fs-6">Đang sử dụng</span>
        }
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="text-muted small">Bệnh nhân</div>
            <div class="fw-semibold">@Model.PatientName @(Model.Age.HasValue ? $"({Model.Age} tuổi)" : "")</div>
        </div>
        <div class="col-md-4">
            <div class="text-muted small">Giới tính</div>
            <div class="fw-semibold">@(Model.Gender ?? "-")</div>
        </div>
        <div class="col-md-4">
            <div class="text-muted small">Bác sĩ</div>
            <div class="fw-semibold">@(Model.DoctorName ?? "-")</div>
        </div>
        <div class="col-md-12 mt-2">
            <div class="text-muted small">Chẩn đoán</div>
            <div class="fw-semibold">@(Model.Diagnosis ?? "-")</div>
        </div>
    </div>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Tên thuốc</th>
                <th>Liều dùng</th>
                <th class="text-end">Số lượng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Details)
            {
                <tr>
                    <td>@d.MedicineName <div class="text-muted small">@d.MedicineCode</div></td>
                    <td>@d.Dosage</td>
                    <td class="text-end">@d.Quantity</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <div class="alert alert-light border small">
            <strong>Lưu ý:</strong> @Model.Note
        </div>
    }

    <div class="mt-3 d-flex gap-2">
        @if (Model.Status != "Đã giao")
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Đã giao" />
                <button type="submit" class="btn btn-success">✔ Đã giao</button>
            </form>
        }
        else
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Đang sử dụng" />
                <button type="submit" class="btn btn-outline-secondary">Chuyển lại "Đang sử dụng"</button>
            </form>
        }
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">In đơn thuốc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
</div>
