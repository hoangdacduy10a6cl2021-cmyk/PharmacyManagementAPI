@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    bool isAdmin = role == "Admin";
    string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string ActiveClass(string controllerName) => CurrentController.Equals(controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Tâm Thần Pharmacy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/pharmacy.css" />
</head>
<body class="@(isAdmin ? "theme-admin" : "theme-staff")">
    <div class="pharmacy-wrapper">
        <aside class="pharmacy-sidebar">
            <div class="brand">
                <span>💊</span> Tâm Thần Pharmacy
                @if (isAdmin)
                {
                    <span class="badge bg-light text-dark ms-1" style="font-size:0.65rem;">ADMIN</span>
                }
            </div>

            <nav class="nav flex-column">
                <a class="nav-link @ActiveClass("Home")" asp-controller="Home" asp-action="Index">🏠 Trang chủ</a>
                <a class="nav-link @ActiveClass("Order")" asp-controller="Order" asp-action="Index">🛒 Bán hàng</a>
                <a class="nav-link @ActiveClass("Prescription")" asp-controller="Prescription" asp-action="Index">📋 Đơn thuốc</a>
                <a class="nav-link @ActiveClass("Customer")" asp-controller="Customer" asp-action="Index">👥 Khách hàng</a>
                <a class="nav-link @ActiveClass("Medicine")" asp-controller="Medicine" asp-action="Index">💊 Thuốc / Kho</a>

                @if (isAdmin)
                {
                    <div class="nav-section-title">Quản trị</div>
                    <a class="nav-link @ActiveClass("Category")" asp-controller="Category" asp-action="Index">🏷️ Danh mục</a>
                    <a class="nav-link @ActiveClass("Supplier")" asp-controller="Supplier" asp-action="Index">🚚 Nhà cung cấp</a>
                    <a class="nav-link @ActiveClass("PurchaseOrder")" asp-controller="PurchaseOrder" asp-action="Index">📦 Nhập hàng</a>
                    <a class="nav-link @ActiveClass("Promotion")" asp-controller="Promotion" asp-action="Index">🏷️ Khuyến mãi</a>
                }

                <div class="nav-section-title">Báo cáo</div>
                <a class="nav-link @ActiveClass("Report")" asp-controller="Report" asp-action="Index">📊 Báo cáo</a>
            </nav>
        </aside>

        <div class="pharmacy-main">
            <header class="pharmacy-topbar">
                <div class="fw-semibold">@ViewData["Title"]</div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-semibold">@fullName</div>
                        <div class="badge-role small px-2 py-1 rounded">@(isAdmin ? "Quản trị viên" : "Nhân viên bán hàng / Dược sĩ")</div>
                    </div>
                    <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                </div>
            </header>

            <main class="pharmacy-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
