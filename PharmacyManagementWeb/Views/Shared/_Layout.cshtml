@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    bool isAdmin = role == "Admin";
    string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string CurrentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string controllerName, params string[] actions) =>
        CurrentController.Equals(controllerName, StringComparison.OrdinalIgnoreCase)
        && (actions.Length == 0 || actions.Contains(CurrentAction, StringComparer.OrdinalIgnoreCase)) ? "active" : "";
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?" : fullName.Trim().Split(' ').Last().Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Tâm Thần Pharmacy</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect x='35' y='4' width='30' height='92' rx='10' fill='%2310b981'/%3E%3Crect x='4' y='35' width='92' height='30' rx='10' fill='%2310b981'/%3E%3Cpath d='M36 72C36 46 54 30 76 28C76 52 62 72 36 72Z' fill='white'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/pharmacy.css" asp-append-version="true" />
</head>
<body class="@(isAdmin ? "theme-admin" : "theme-staff")">
    <div class="pharmacy-wrapper">
        <aside class="pharmacy-sidebar">
            <div class="brand">
                <svg class="brand-logo-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="gSide" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#34d399" />
                            <stop offset="1" stop-color="#0d9488" />
                        </linearGradient>
                    </defs>
                    <rect x="35" y="4" width="30" height="92" rx="10" fill="url(#gSide)" />
                    <rect x="4" y="35" width="92" height="30" rx="10" fill="url(#gSide)" />
                    <path d="M36 72 C36 46 54 30 76 28 C76 52 62 72 36 72 Z" fill="#fff" />
                    <path d="M38 70 C46 58 56 49 68 40" stroke="#0d9488" stroke-width="2.2" fill="none" stroke-linecap="round" />
                </svg>
                <div>
                    <div class="brand-name">Tâm Thần Pharmacy</div>
                    <div class="brand-tagline">Vì sức khoẻ cộng đồng</div>
                </div>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i><span>Trang chủ</span></a>
                <a class="nav-link @Active("Order", "Index", "Create")" asp-controller="Order" asp-action="Index"><i class="bi bi-cart3"></i><span>Bán hàng</span></a>
                <a class="nav-link @Active("Order", "History", "Detail")" asp-controller="Order" asp-action="History"><i class="bi bi-receipt"></i><span>Hoá đơn</span></a>
                <a class="nav-link @Active("Return")" asp-controller="Return" asp-action="Index"><i class="bi bi-arrow-return-left"></i><span>Đổi trả</span></a>
                <a class="nav-link @Active("Prescription")" asp-controller="Prescription" asp-action="Index"><i class="bi bi-journal-medical"></i><span>Đơn thuốc</span></a>
                <a class="nav-link @Active("Customer")" asp-controller="Customer" asp-action="Index"><i class="bi bi-people"></i><span>Khách hàng</span></a>
                <a class="nav-link @Active("Medicine")" asp-controller="Medicine" asp-action="Index"><i class="bi bi-capsule"></i><span>Thuốc / Kho</span></a>
                <a class="nav-link @Active("Alert")" asp-controller="Alert" asp-action="Index"><i class="bi bi-exclamation-triangle"></i><span>Cảnh báo</span></a>

                @if (isAdmin)
                {
                    <div class="nav-section-title">Quản trị</div>
                    <a class="nav-link @Active("Category")" asp-controller="Category" asp-action="Index"><i class="bi bi-tags"></i><span>Danh mục</span></a>
                    <a class="nav-link @Active("Supplier")" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck"></i><span>Nhà cung cấp</span></a>
                    <a class="nav-link @Active("PurchaseOrder")" asp-controller="PurchaseOrder" asp-action="Index"><i class="bi bi-box-seam"></i><span>Nhập hàng</span></a>
                    <a class="nav-link @Active("StockCheck")" asp-controller="StockCheck" asp-action="Index"><i class="bi bi-clipboard-check"></i><span>Kiểm kê kho</span></a>
                    <a class="nav-link @Active("Promotion")" asp-controller="Promotion" asp-action="Index"><i class="bi bi-percent"></i><span>Khuyến mãi</span></a>
                    <a class="nav-link @Active("User", "Index", "Create", "Edit")" asp-controller="User" asp-action="Index"><i class="bi bi-person-badge"></i><span>Nhân viên</span></a>
                    <a class="nav-link @Active("User", "Permissions")" asp-controller="User" asp-action="Permissions"><i class="bi bi-shield-lock"></i><span>Phân quyền</span></a>
                    <a class="nav-link @Active("AuditLog")" asp-controller="AuditLog" asp-action="Index"><i class="bi bi-clock-history"></i><span>Nhật ký</span></a>

                    <div class="nav-section-title">Báo cáo</div>
                    <a class="nav-link @Active("Report", "Index")" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>Doanh thu</span></a>
                    <a class="nav-link @Active("Report", "Profit")" asp-controller="Report" asp-action="Profit"><i class="bi bi-graph-up-arrow"></i><span>Lợi nhuận</span></a>
                    <a class="nav-link @Active("Report", "Payments")" asp-controller="Report" asp-action="Payments"><i class="bi bi-wallet2"></i><span>Thanh toán</span></a>
                }
            </nav>
        </aside>

        <div class="pharmacy-main">
            <header class="pharmacy-topbar">
                <div class="topbar-title">@ViewData["Title"]</div>

                <form class="topbar-search" asp-controller="Medicine" asp-action="Index" method="get">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" placeholder="Tìm tên thuốc, mã thuốc, mã vạch..." autocomplete="off" />
                </form>

                <div class="d-flex align-items-center gap-3">
                    @await Component.InvokeAsync("NotificationBell")

                    <div class="text-end lh-sm">
                        <div class="fw-semibold">@fullName</div>
                        <span class="badge-role small px-2 py-1 rounded d-inline-block mt-1" style="font-size:0.72rem;">@(isAdmin ? "Quản trị viên" : "Nhân viên bán hàng / Dược sĩ")</span>
                    </div>

                    <div class="dropdown">
                        <button type="button" class="user-avatar border-0" data-bs-toggle="dropdown" aria-expanded="false" title="Tài khoản">@initial</button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border-radius:14px;">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>Tài khoản cá nhân</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="pharmacy-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>