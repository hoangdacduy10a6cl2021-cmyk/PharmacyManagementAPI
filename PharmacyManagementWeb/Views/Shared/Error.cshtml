@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="stat-card error-page">
    <div class="big-icon"><i class="bi bi-exclamation-triangle"></i></div>
    <h4 class="fw-bold mt-3">Rất tiếc, đã có lỗi xảy ra</h4>
    <p class="text-muted">Hệ thống không thể xử lý yêu cầu của bạn. Vui lòng thử lại hoặc liên hệ quản trị viên.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-success"><i class="bi bi-house-door me-1"></i>Về trang chủ</a>
</div>