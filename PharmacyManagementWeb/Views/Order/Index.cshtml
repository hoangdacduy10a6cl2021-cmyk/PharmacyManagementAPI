@{
    ViewData["Title"] = "Bán hàng";
    var customers = ViewBag.Customers as List<PharmacyManagementWeb.Models.ApiModels.CustomerModel> ?? new();
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="stat-card mb-3">
            <label class="form-label small mb-1">Tìm thuốc, mã, mã vạch</label>
            <div class="position-relative">
                <input type="text" id="medicineSearch" class="form-control" placeholder="Nhập tên hoặc mã thuốc để tìm..." autocomplete="off" />
                <div id="searchResults" class="list-group position-absolute w-100 shadow" style="z-index: 1000; max-height: 260px; overflow-y: auto; display:none;"></div>
            </div>
        </div>

        <div class="stat-card">
            <h6 class="mb-3">Giỏ hàng</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Tên thuốc</th>
                            <th class="text-end">Đơn giá</th>
                            <th style="width:100px;">Số lượng</th>
                            <th>Tồn kho</th>
                            <th class="text-end">Thành tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cartBody">
                        <tr id="emptyCartRow">
                            <td colspan="6" class="text-center text-muted py-3">Chưa có thuốc nào trong giỏ hàng.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="stat-card mb-3">
            <label class="form-label small mb-1">Khách hàng</label>
            <div class="d-flex gap-2">
                <select id="customerSelect" class="form-select">
                    <option value="">-- Khách vãng lai --</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.Name @(string.IsNullOrEmpty(c.Phone) ? "" : $"- {c.Phone}")</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#newCustomerModal">+ Mới</button>
            </div>
        </div>

        <div class="stat-card">
            <h6 class="mb-3">Thông tin đơn hàng</h6>

            <div class="d-flex justify-content-between mb-2">
                <span>Tạm tính</span>
                <span id="totalAmountText">0đ</span>
            </div>

            <div class="mb-3">
                <label class="form-label small mb-1">Giảm giá (đ)</label>
                <input type="number" id="discountInput" class="form-control" value="0" min="0" />
            </div>

            <div class="d-flex justify-content-between mb-3 fw-bold fs-5">
                <span>Tổng cộng</span>
                <span id="finalAmountText" class="text-success">0đ</span>
            </div>

            <label class="form-label small mb-1">Hình thức thanh toán</label>
            <select id="paymentMethod" class="form-select mb-3">
                <option value="Tiền mặt">Tiền mặt</option>
                <option value="Chuyển khoản">Chuyển khoản</option>
                <option value="Thẻ">Thẻ</option>
                <option value="Ví điện tử">Ví điện tử</option>
            </select>

            <form id="checkoutForm" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" id="hiddenCustomerId" />
                <input type="hidden" name="cartJson" id="hiddenCartJson" />
                <input type="hidden" name="discountAmount" id="hiddenDiscount" />
                <input type="hidden" name="paymentMethod" id="hiddenPaymentMethod" />
                <button type="submit" id="checkoutBtn" class="btn btn-success w-100 py-2" disabled>Thanh toán (F9)</button>
            </form>
        </div>
    </div>
</div>

<!-- Modal tạo khách hàng nhanh -->
<div class="modal fade" id="newCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Thêm khách hàng mới</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="newCustomerError" class="alert alert-danger py-2 d-none"></div>
                <div class="mb-2">
                    <label class="form-label small">Họ tên</label>
                    <input type="text" id="newCustomerName" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Số điện thoại</label>
                    <input type="text" id="newCustomerPhone" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Địa chỉ</label>
                    <input type="text" id="newCustomerAddress" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" id="saveNewCustomerBtn" class="btn btn-success">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cart = []; // { medicineId, code, name, unit, sellPrice, stock, quantity }

    const searchInput = document.getElementById('medicineSearch');
    const searchResults = document.getElementById('searchResults');
    let searchTimeout;

    searchInput.addEventListener('input', function () {
        clearTimeout(searchTimeout);
        const term = this.value.trim();
        if (term.length === 0) { searchResults.style.display = 'none'; return; }

        searchTimeout = setTimeout(async () => {
            const res = await fetch('/Order/SearchMedicine?term=' + encodeURIComponent(term));
            const data = await res.json();
            renderSearchResults(data);
        }, 250);
    });

    function renderSearchResults(items) {
        if (!items.length) {
            searchResults.innerHTML = '<div class="list-group-item text-muted small">Không tìm thấy thuốc.</div>';
            searchResults.style.display = 'block';
            return;
        }

        searchResults.innerHTML = items.map(m => `
            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between"
                    onclick='addToCart(${JSON.stringify(m)})'>
                <span>${m.name} <span class="text-muted small">(${m.code})</span></span>
                <span class="text-success">${m.sellPrice.toLocaleString('vi-VN')}đ - Tồn: ${m.stock}</span>
            </button>
        `).join('');
        searchResults.style.display = 'block';
    }

    document.addEventListener('click', function (e) {
        if (!searchResults.contains(e.target) && e.target !== searchInput) {
            searchResults.style.display = 'none';
        }
    });

    function addToCart(medicine) {
        const existing = cart.find(i => i.medicineId === medicine.id);
        if (existing) {
            if (existing.quantity < medicine.stock) existing.quantity++;
        } else {
            if (medicine.stock <= 0) { alert('Thuốc này đã hết hàng.'); return; }
            cart.push({
                medicineId: medicine.id,
                code: medicine.code,
                name: medicine.name,
                unit: medicine.unit,
                sellPrice: medicine.sellPrice,
                stock: medicine.stock,
                quantity: 1
            });
        }
        searchInput.value = '';
        searchResults.style.display = 'none';
        renderCart();
    }

    function removeFromCart(medicineId) {
        cart = cart.filter(i => i.medicineId !== medicineId);
        renderCart();
    }

    function updateQuantity(medicineId, qty) {
        const item = cart.find(i => i.medicineId === medicineId);
        if (!item) return;
        qty = parseInt(qty) || 1;
        if (qty < 1) qty = 1;
        if (qty > item.stock) { alert('Số lượng vượt quá tồn kho (' + item.stock + ')'); qty = item.stock; }
        item.quantity = qty;
        renderCart();
    }

    function renderCart() {
        const cartBody = document.getElementById('cartBody');

        if (cart.length === 0) {
            cartBody.innerHTML = '<tr id="emptyCartRow"><td colspan="6" class="text-center text-muted py-3">Chưa có thuốc nào trong giỏ hàng.</td></tr>';
        } else {
            cartBody.innerHTML = cart.map(i => `
                <tr>
                    <td>${i.name} <div class="text-muted small">${i.code}</div></td>
                    <td class="text-end">${i.sellPrice.toLocaleString('vi-VN')}đ</td>
                    <td><input type="number" class="form-control form-control-sm" value="${i.quantity}" min="1" max="${i.stock}"
                               onchange="updateQuantity(${i.medicineId}, this.value)" /></td>
                    <td>${i.stock} ${i.unit}</td>
                    <td class="text-end">${(i.sellPrice * i.quantity).toLocaleString('vi-VN')}đ</td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFromCart(${i.medicineId})">&times;</button></td>
                </tr>
            `).join('');
        }

        updateSummary();
    }

    function updateSummary() {
        const totalAmount = cart.reduce((sum, i) => sum + i.sellPrice * i.quantity, 0);
        const discount = parseFloat(document.getElementById('discountInput').value) || 0;
        let finalAmount = totalAmount - discount;
        if (finalAmount < 0) finalAmount = 0;

        document.getElementById('totalAmountText').textContent = totalAmount.toLocaleString('vi-VN') + 'đ';
        document.getElementById('finalAmountText').textContent = finalAmount.toLocaleString('vi-VN') + 'đ';
        document.getElementById('checkoutBtn').disabled = cart.length === 0;
    }

    document.getElementById('discountInput').addEventListener('input', updateSummary);

    // Submit form: gói cart thành JSON trước khi gửi
    document.getElementById('checkoutForm').addEventListener('submit', function (e) {
        if (cart.length === 0) { e.preventDefault(); return; }

        document.getElementById('hiddenCustomerId').value = document.getElementById('customerSelect').value;
        document.getElementById('hiddenCartJson').value = JSON.stringify(cart.map(i => ({ medicineId: i.medicineId, quantity: i.quantity })));
        document.getElementById('hiddenDiscount').value = document.getElementById('discountInput').value || 0;
        document.getElementById('hiddenPaymentMethod').value = document.getElementById('paymentMethod').value;
    });

    // Tạo khách hàng nhanh qua modal
    document.getElementById('saveNewCustomerBtn').addEventListener('click', async function () {
        const name = document.getElementById('newCustomerName').value.trim();
        const phone = document.getElementById('newCustomerPhone').value.trim();
        const address = document.getElementById('newCustomerAddress').value.trim();
        const errorBox = document.getElementById('newCustomerError');
        errorBox.classList.add('d-none');

        if (!name) { errorBox.textContent = 'Vui lòng nhập họ tên.'; errorBox.classList.remove('d-none'); return; }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();
        formData.append('name', name);
        formData.append('phone', phone);
        formData.append('address', address);

        const res = await fetch('/Order/QuickCreateCustomer', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });

        const data = await res.json();

        if (!res.ok) {
            errorBox.textContent = data.message || 'Không thể tạo khách hàng.';
            errorBox.classList.remove('d-none');
            return;
        }

        const select = document.getElementById('customerSelect');
        const option = document.createElement('option');
        option.value = data.id;
        option.textContent = data.name;
        option.selected = true;
        select.appendChild(option);

        document.getElementById('newCustomerName').value = '';
        document.getElementById('newCustomerPhone').value = '';
        document.getElementById('newCustomerAddress').value = '';

        var modal = bootstrap.Modal.getInstance(document.getElementById('newCustomerModal'));
        modal.hide();
    });

    // Phím tắt F9 = Thanh toán (giống mockup)
    document.addEventListener('keydown', function (e) {
        if (e.key === 'F9') {
            e.preventDefault();
            if (!document.getElementById('checkoutBtn').disabled) {
                document.getElementById('checkoutForm').requestSubmit();
            }
        }
    });
</script>
}
